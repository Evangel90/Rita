# Server Configuration
PORT=3001

# MongoDB Atlas Connection
# For testing/dev, use a dedicated development database cluster.
# Tip: Change "rita-dev" to "rita-dev-yourname" to isolate your data from teammates.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/rita-dev?retryWrites=true&w=majority

# Blockchain RPC (e.g., Alchemy, Infura)
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
